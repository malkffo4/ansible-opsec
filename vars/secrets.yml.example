# Переименуйте этот файл в secrets.yml и впишите свои данные
secret_matrix_homeserver: "https://matrix.org"
secret_matrix_roomid: "!yourroom:matrix.org"
secret_matrix_token: "YOUR_TOKEN"
secret_matrix_token_laptop: "syt_token_1..."
secret_matrix_token_server: "syt_token_2..."
secret_webhook_url: ""

# Новый SSH-порт, на который переедет сервер ПОСЛЕ хардненинга.
# Должен отличаться от 22 и не совпадать с портами VPN ниже.
secret_ssh_port: 2222

secret_canary_file: "/var/log/fake_passwords.txt"

# Порты, которые слушает Amnezia (или другой VPN-сервер) и которые нельзя
# блокировать файрволом. Плейбук ТАКЖЕ пытается автоматически найти их
# через `ss -tulpn` (см. roles/custom_env/tasks/firewall.yml), но явный
# список — самый надёжный вариант, если автообнаружение ошибётся.
# Узнать реальные порты Amnezia:
#   - если ставили через официальный установщик (Docker): `docker ps` —
#     колонка PORTS покажет host-порты контейнеров (obfs4/awg/openvpn/...)
#   - либо `ss -tulpn | grep -v 127.0.0.1` на самом сервере
extra_allowed_ports:
  - {port: 443, proto: tcp}
  - {port: 443, proto: udp}
  # - {port: 36712, proto: udp}  # пример для AmneziaWG

# Ваш домашний/рабочий IP — чтобы fail2ban никогда не забанил ВАС самого
# при опечатке в пароле/ключе во время тестов. Узнать свой IP: curl ifconfig.me
ignore_ips: ""